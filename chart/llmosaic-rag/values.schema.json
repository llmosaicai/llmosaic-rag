{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "llmosaic-db": { "type": "object" },
    "sso": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string" },
        "secretName": { "type": "string" }
      },
      "additionalProperties": true
    },
    "deps": {
      "type": "object",
      "properties": {
        "llmosaic_db": {
          "type": "object",
          "properties": {
            "repo_url": { "type": "string" },
            "repo_ref": { "type": "string" },
            "chart_path": { "type": "string" },
            "vendor": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "jupyterlab": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "hostTemplate": { "type": "string" },
        "pvc": { "type": "object", "properties": { "size": { "type": "string" } }, "additionalProperties": false },
        "resources": { "type": "object" },
        "envFromSecrets": { "type": "array", "items": { "type": "string" } },
        "ingress": {
          "type": "object",
          "properties": {
            "middlewares": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "sso": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerUrl": { "type": "string" },
            "secretRef": { "type": "object", "properties": { "name": { "type": "string" } }, "additionalProperties": false },
            "extraArgs": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "llmosaic-db": { "type": "object" },
    "sso": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string" },
        "secretName": { "type": "string" }
      },
      "additionalProperties": true
    },
    "deps": {
      "type": "object",
      "properties": {
        "llmosaic_db": {
          "type": "object",
          "properties": {
            "repo_url": { "type": "string" },
            "repo_ref": { "type": "string" },
            "chart_path": { "type": "string" },
            "vendor": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "jupyterlab": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "preload": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "source": { "type": "string", "enum": ["inline","image"] },
            "image": { "type": "string" },
            "notebooks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "content": { "type": "string" },
                  "destPath": { "type": "string" }
                },
                "required": ["name","content","destPath"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "envDump": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["name","value"],
            "additionalProperties": false
          }
        },
        "hostTemplate": { "type": "string" },
        "pvc": { "type": "object", "properties": { "size": { "type": "string" } }, "additionalProperties": false },
        "resources": { "type": "object" },
        "envFromSecrets": { "type": "array", "items": { "type": "string" } },
        "ingress": {
          "type": "object",
          "properties": {
            "middlewares": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "sso": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerUrl": { "type": "string" },
            "secretRef": { "type": "object", "properties": { "name": { "type": "string" } }, "additionalProperties": false },
            "extraArgs": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "rag": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "pvc": {
              "type": "object",
              "properties": {
                "size": { "type": "string" }
              },
              "additionalProperties": false
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "repo_url": { "type": "string" },
                  "repo_ref": { "type": "string" }
                },
                "required": ["name","repo_url"],
                "additionalProperties": false
              }
            },
            "mounts": {
              "type": "object",
              "properties": {
                "jupyterlab": { "type": "object", "properties": { "enabled": {"type":"boolean"}, "mountPath": {"type":"string"} }, "additionalProperties": false },
                "proxy": { "type": "object", "properties": { "enabled": {"type":"boolean"}, "mountPath": {"type":"string"} }, "additionalProperties": false }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "examples": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "source": { "type": "string", "enum": ["dvc"] },
            "image": { "type": "string" },
            "dvc": {
              "type": "object",
              "properties": {
                "envFromSecretName": { "type": "string" },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "repo_url": { "type": "string" },
                      "repo_ref": { "type": "string" },
                      "path": { "type": "string" },
                      "to": { "type": "string" }
                    },
                    "required": ["repo_url","path","to"],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
